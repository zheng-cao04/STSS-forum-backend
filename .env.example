APP_NAME=STSS Forum Backend
ENV=development
FORUM_PORT=8005
DATABASE_URL=sqlite:///./data/forum.db
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PREFIX=/api/v1/forum/uploads
LEGACY_UPLOAD_PREFIX=/uploads
ENABLE_CORS=true
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SKIP_EXTERNAL_CHECKS=true
INFO_SERVICE_URL=http://localhost:8002
COURSE_SELECTION_SERVICE_URL=http://localhost:8003
SCORE_SERVICE_URL=http://localhost:8004
INTERNAL_TOKEN=dev-internal-token
